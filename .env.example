POSTGRES_USER=fpcollector
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fpcollector
DATABASE_URL=postgresql://fpcollector:changeme@db:5432/fpcollector
RATE_LIMIT_PER_MINUTE=100
# Comma-separated list of allowed CORS origins. Use * for development only.
ALLOWED_ORIGINS=https://fp.home.arpa,https://collector.home.arpa
WORKER_POLL_INTERVAL=10
SIMULATOR_COLLECTOR_URL=http://api:8000/v1/events
SIMULATOR_INTERVAL_MIN=30
SIMULATOR_INTERVAL_MAX=180

# Dev defaults bind db to 127.0.0.1:15432 to avoid colliding with a system PostgreSQL.
# On dokploy-lab, set POSTGRES_BIND_IP=192.168.1.50 and POSTGRES_HOST_PORT=5432
# so martech-lab's n8n can reach the database via the Proxmox host LAN.
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_HOST_PORT=15432
