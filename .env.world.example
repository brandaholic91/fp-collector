# Environment of the world instance. Copy to .env.world (gitignored).
# Reachable on 127.0.0.1 only and holds disposable data: the password is not a secret.
POSTGRES_USER=fpworld
POSTGRES_PASSWORD=fpworld_local
POSTGRES_DB=fpworld
DATABASE_URL=postgresql://fpworld:fpworld_local@db:5432/fpworld
ALLOWED_ORIGINS=*
WORKER_POLL_INTERVAL=1
ECOMMERCE_ENABLED=true
WORKER_BATCHED=true
